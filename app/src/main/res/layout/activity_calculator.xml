<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingEnd="@dimen/screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="71dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_back"
            app:tint="@color/foreground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:text="@string/calculator_title"
            android:textColor="@color/foreground"
            android:textSize="17sp" />

        <View
            android:layout_width="42dp"
            android:layout_height="42dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_calc_display"
        android:gravity="bottom"
        android:minHeight="170dp"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/expressionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="13dp"
            android:ellipsize="start"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/calculator_ready"
            android:textColor="@color/summary_label"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:gravity="end"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="42sp" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_calc_keypad"
        android:columnCount="4"
        android:padding="10dp"
        android:rowCount="5" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:gravity="center"
        android:text="@string/calculator_helper"
        android:textColor="@color/mutedForeground"
        android:textSize="12sp" />

</LinearLayout>
