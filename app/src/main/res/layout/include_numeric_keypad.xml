<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:columnCount="3"
    android:rowCount="4">

    <TextView android:id="@+id/key1" style="@style/Widget.PinKey" android:text="1" />
    <TextView android:id="@+id/key2" style="@style/Widget.PinKey" android:text="2" />
    <TextView android:id="@+id/key3" style="@style/Widget.PinKey" android:text="3" />
    <TextView android:id="@+id/key4" style="@style/Widget.PinKey" android:text="4" />
    <TextView android:id="@+id/key5" style="@style/Widget.PinKey" android:text="5" />
    <TextView android:id="@+id/key6" style="@style/Widget.PinKey" android:text="6" />
    <TextView android:id="@+id/key7" style="@style/Widget.PinKey" android:text="7" />
    <TextView android:id="@+id/key8" style="@style/Widget.PinKey" android:text="8" />
    <TextView android:id="@+id/key9" style="@style/Widget.PinKey" android:text="9" />

    <ImageButton
        android:id="@+id/keyBackspace"
        style="@style/Widget.PinKeyButton"
        android:src="@drawable/ic_backspace" />

    <TextView android:id="@+id/key0" style="@style/Widget.PinKey" android:text="0" />

    <ImageButton
        android:id="@+id/keyDone"
        style="@style/Widget.PinKeyButton"
        android:src="@drawable/ic_check" />

</GridLayout>
