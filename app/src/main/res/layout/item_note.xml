<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/noteCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="11dp"
    android:background="@drawable/bg_note_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal">

    <View
        android:id="@+id/noteAccent"
        android:layout_width="5dp"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/noteTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:maxLines="1"
                android:textColor="@color/foreground"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/notePinIcon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_pin_filled"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/noteBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:alpha="0.84"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="2"
            android:minHeight="38dp"
            android:textColor="@color/cardForeground"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/noteDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/mutedForeground"
                android:textSize="11sp" />

            <ImageButton
                android:id="@+id/pinAction"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_pin"
                android:padding="6dp"
                android:src="@drawable/ic_pin_outline"
                app:tint="@color/mutedForeground" />

            <ImageButton
                android:id="@+id/archiveAction"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_archive"
                android:padding="6dp"
                android:src="@drawable/ic_archive"
                app:tint="@color/mutedForeground" />

            <ImageButton
                android:id="@+id/trashAction"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_trash"
                android:padding="6dp"
                android:src="@drawable/ic_trash"
                app:tint="@color/mutedForeground" />

            <ImageButton
                android:id="@+id/restoreAction"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_restore"
                android:padding="6dp"
                android:src="@drawable/ic_restore"
                android:visibility="gone"
                app:tint="@color/mutedForeground" />

            <ImageButton
                android:id="@+id/deleteForeverAction"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/cd_delete_forever"
                android:padding="6dp"
                android:src="@drawable/ic_trash"
                android:visibility="gone"
                app:tint="@color/destructive" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
