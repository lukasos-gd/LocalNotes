<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:minHeight="71dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_back"
            app:tint="@color/foreground" />

        <TextView
            android:id="@+id/topTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:textColor="@color/foreground"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_save_button"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                app:tint="@color/primaryForeground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:text="@string/save"
                android:textColor="@color/primaryForeground"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <LinearLayout
                android:id="@+id/paperCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_paper_card"
                android:minHeight="460dp"
                android:orientation="vertical"
                android:padding="21dp">

                <View
                    android:id="@+id/paperAccent"
                    android:layout_width="42dp"
                    android:layout_height="4dp"
                    android:layout_marginBottom="30dp"
                    android:background="@drawable/bg_paper_accent" />

                <EditText
                    android:id="@+id/titleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fontFamily="sans-serif"
                    android:textStyle="bold"
                    android:hint="@string/title_hint"
                    android:textColorHint="@color/mutedForeground"
                    android:inputType="textCapSentences"
                    android:maxLines="3"
                    android:padding="0dp"
                    android:layout_marginBottom="20dp"
                    android:textColor="@color/foreground"
                    android:textSize="25sp" />

                <EditText
                    android:id="@+id/bodyInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="295dp"
                    android:background="@android:color/transparent"
                    android:gravity="top"
                    android:hint="@string/body_hint"
                    android:textColorHint="@color/mutedForeground"
                    android:inputType="textMultiLine|textCapSentences"
                    android:lineSpacingExtra="9dp"
                    android:padding="0dp"
                    android:textColor="@color/cardForeground"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/saved_locally_hint"
                    android:textColor="@color/mutedForeground"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:text="@string/note_color_label"
                android:textColor="@color/foreground"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/swatchRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:background="@drawable/bg_tip_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/accentForeground" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/privacy_tip"
                    android:textColor="@color/accentForeground"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
